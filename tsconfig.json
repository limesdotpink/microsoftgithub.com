{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "target": "es2025",
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "dist",
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"]
}
